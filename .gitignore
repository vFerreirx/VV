# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local
supabase/.branches
supabase/.temp

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# claude code
# Skills instaladas (mattpocock/skills etc.) sao ferramenta de quem edita,
# nao do projeto: ficam em ~/.claude/skills. A regra vale pra quando alguem
# instalar uma aqui por engano — `npx skills add` escreve no diretorio atual.
# `launch.json` continua versionado de proposito; so as skills saem.
.claude/skills/
# Lock do instalador `npx skills add`, que ele escreve na RAIZ do diretorio
# onde roda. Fica de fora pelo mesmo motivo: descreve o setup de quem edita.
skills-lock.json
