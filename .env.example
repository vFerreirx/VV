# ============================================================
# Malharia MVP — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# Nunca comite .env.local — ele está no .gitignore.
# ============================================================

# --- Supabase (cliente público — exposto ao browser) ---
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key-do-supabase-status>"

# --- Supabase (server-only — NUNCA expor ao client) ---
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-do-supabase-status>"

# --- Postgres (Drizzle migrations + seeds + queries server-side) ---
# Em desenvolvimento local com `supabase start`, a porta padrão é 54322.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
#
# ⚠️ FORA DA MÁQUINA LOCAL, TERMINE A URL COM `?sslmode=require`:
#   DATABASE_URL="postgresql://...@<projeto>.pooler.supabase.com:6543/postgres?sslmode=require"
#
# No protocolo Postgres quem começa o TLS é o CLIENTE. O driver (`postgres`)
# tem `ssl: false` por padrão, então SEM esse parâmetro a conexão sai em
# CLARO — dado de cliente, preço e pedido legíveis pra quem estiver no
# caminho. O servidor da Supabase aceita TLS 1.3, mas não obriga: sondado na
# mão, ele responde 'S' ao preâmbulo SSLRequest e segue em texto puro se
# ninguém pedir.
#
# Por que aqui e não em src/lib/db/index.ts: o Postgres local do
# `supabase start` NÃO fala TLS. Fixado no código, o dev local quebraria.
# Na URL, cada ambiente decide sozinho e o app, o drizzle-kit e os scripts
# são corrigidos de uma vez, porque todos leem esta mesma variável.
#
# ⚠️ Não troque por `sslmode=verify-full`: o certificado é da CA própria da
# Supabase e o Node recusa com "self-signed certificate in certificate
# chain" (testado). `require` CRIPTOGRAFA mas não autentica o servidor;
# autenticar exige baixar o certificado em Project Settings → Database →
# SSL Configuration e passá-lo por env var. É um passo separado.
#
# Conferir se está criptografado: `pg_stat_ssl` NÃO SERVE com o pooler — ele
# mede a perna Supavisor→Postgres e responde `ssl=false` mesmo numa conexão
# criptografada. Use o preâmbulo SSLRequest cru, ou o fato de que `ssl: true`
# falha com erro de CERTIFICADO (que só existe se houve handshake TLS).

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Melhor Envio (server-only — NUNCA expor ao client) ---
# Token da API. Sem ele o botão "Cotar frete" fica desabilitado com
# explicação; nada quebra. Sandbox e produção usam tokens DIFERENTES — o de
# sandbox não autentica em produção.
MELHOR_ENVIO_TOKEN=""
# Sandbox por padrão. Pra ir a produção, troque por:
#   MELHOR_ENVIO_URL="https://melhorenvio.com.br"
MELHOR_ENVIO_URL="https://sandbox.melhorenvio.com.br"
# A doc pede nome da aplicação e e-mail técnico, pra eles conseguirem falar
# com quem está chamando. Formato: "Nome da App (email@dominio.com)".
MELHOR_ENVIO_USER_AGENT=""
