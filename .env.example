# ============================================================
# Malharia MVP — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# Nunca comite .env.local — ele está no .gitignore.
# ============================================================

# --- Supabase (cliente público — exposto ao browser) ---
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key-do-supabase-status>"

# --- Supabase (server-only — NUNCA expor ao client) ---
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-do-supabase-status>"

# --- Postgres (Drizzle migrations + seeds + queries server-side) ---
# Em desenvolvimento local com `supabase start`, a porta padrão é 54322.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Melhor Envio (server-only — NUNCA expor ao client) ---
# Token da API. Sem ele o botão "Cotar frete" fica desabilitado com
# explicação; nada quebra. Sandbox e produção usam tokens DIFERENTES — o de
# sandbox não autentica em produção.
MELHOR_ENVIO_TOKEN=""
# Sandbox por padrão. Pra ir a produção, troque por:
#   MELHOR_ENVIO_URL="https://melhorenvio.com.br"
MELHOR_ENVIO_URL="https://sandbox.melhorenvio.com.br"
# A doc pede nome da aplicação e e-mail técnico, pra eles conseguirem falar
# com quem está chamando. Formato: "Nome da App (email@dominio.com)".
MELHOR_ENVIO_USER_AGENT=""
